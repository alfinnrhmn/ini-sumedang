# Salin ke .env (lokal) atau isi di secret manager hosting. JANGAN isi nilai asli di file ini.

# URL WordPress (tanpa slash akhir). Dibaca server saja -> NUXT_WP_BASE_URL
NUXT_WP_BASE_URL=https://cms.example.com

# Hanya jika perlu preview draft / endpoint terproteksi. Role minimum, read-only.
# NUXT_WP_USER=
# NUXT_WP_APP_PASSWORD=

# URL publik situs (canonical, sitemap, OG). Beda per lingkungan.
NUXT_PUBLIC_SITE_URL=https://staging.example.com

# staging | production  -> staging menghasilkan robots "Disallow: /" + header noindex
NUXT_PUBLIC_APP_ENV=staging

# Nuxt 4.6 appSecret. Verifikasi di docs apakah wajib di production, lalu isi nilai acak panjang.
# NUXT_APP_SECRET=

# Webhook purge cache dari WordPress (secret bersama)
# NUXT_REVALIDATE_TOKEN=

# Set data contoh (fixture) server: tidak diset/kosong = figma (default, meniru Figma); edge = kasus buruk untuk QA.
# FIXTURE_SET=edge
